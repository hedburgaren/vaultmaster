# VaultMaster — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──
POSTGRES_DB=vaultmaster
POSTGRES_USER=vaultmaster
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://vaultmaster:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/vaultmaster

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT / Security ──
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# ── Backup encryption (age) ──
# Public recipient used to encrypt artifacts in-pipe on the source host.
# Not secret. Generate with: age-keygen -o identity.key
# Jobs with encrypt=true FAIL when this is unset. They do not fall back to
# plaintext. The age binary must also exist on each source host.
AGE_PUBLIC_KEY=
# Private identity, needed only to decrypt during restore/validation.
# Keep an off-box copy: without it, encrypted backups are unrecoverable.
AGE_IDENTITY_FILE=/etc/vaultmaster/age-identity.key

# ── SMTP (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── CORS (optional) ──
# Comma-separated list of allowed origins. Leave empty to allow all.
ALLOWED_ORIGINS=

# ── Notification channels (optional, can also be configured via UI) ──
SLACK_WEBHOOK_URL=
NTFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
